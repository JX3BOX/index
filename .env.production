# 线上正式环境

VUE_APP_CMS_API=https://cms.jx3box.com
VUE_APP_NEXT_API=https://next2.jx3box.com
VUE_APP_PAY_API=https://pay.jx3box.com
VUE_APP_TEAM_API=https://team.jx3box.com
VUE_APP_LUA_API=https://lua.jx3box.com
VUE_APP_NODE_API=https://node.jx3box.com

# 生产环境默认直连后端（无需 Vite dev proxy）
VUE_APP_PROXY_ENABLE=0
VUE_APP_PROXY_PREFIX=/__proxy

# 暂停首页前端异常与接口健康观察，避免 api-metrics/batch 在服务异常时持续重试
# VUE_APP_OBSERVABILITY_ENABLED=1
